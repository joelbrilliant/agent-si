# The hub's address, with DNS pointed at this server and ports 80 and 443 open.
BRAIN_HOST=brain.example.co
# The hub image you built from a release wheel (docs/HUB.md), tagged by version so the old one stays for a rollback.
# ./hub update changes this line and keeps the old one in .env.previous.
BRAIN_IMAGE=agent-si-hub:<the version you built>
BRAIN_CHANNEL=stable
# The offsite copy (optional): an rclone config whose credential can list and put, never delete.
RCLONE_CONFIG=./rclone.conf
OFFSITE_PATH=agent-si-backups
